{
  "$schema": "node_modules/wrangler/config-schema.json",

  // The deployed Worker name. Changing it deploys a *new* Worker and orphans
  // the old one — including its secrets, which are per-Worker.
  "name": "gh-notifier",
  "main": "src/index.js",
  "compatibility_date": "2026-07-25",

  // Hourly, on the hour. Cron Triggers are free (5 per account) and a tick with
  // no net change costs two list requests, so this stays far inside the GitHub
  // rate limit. Shorter windows also narrow the known gap: a star or follow
  // that is undone within a single tick still cancels out unseen.
  "triggers": {
    "crons": ["0 * * * *"]
  },

  // Create your own with: wrangler kv namespace create FOLLOWERS
  // Not a secret — a namespace id is useless without an API token.
  "kv_namespaces": [
    {
      "binding": "FOLLOWERS",
      "id": "268a9a8344ab473db9d88aa5df9c8ccc"
    }
  ],

  // ── Change this to your own GitHub username before deploying. ──
  "vars": {
    "GITHUB_USER": "erfnzdeh"
  },

  "observability": {
    "enabled": true
  }
}
