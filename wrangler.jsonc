{
  "$schema": "node_modules/wrangler/config-schema.json",

  // A *different* Worker name from the single-tenant `gh-notifier` on main.
  // Deploying this branch under that name would replace the personal notifier
  // and orphan its secrets, which are per-Worker.
  "name": "gh-notifier-bot",
  "main": "src/index.js",
  "compatibility_date": "2026-07-25",

  // Every five minutes. Accounts are hashed into 12 shards (see SHARDS in
  // src/index.js), so each is polled once an hour while any single tick only
  // wakes a twelfth of them, which is what keeps a tick inside the free
  // plan's 50 external subrequests per invocation.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  // Its own namespace, separate from the single-tenant Worker's FOLLOWERS.
  // Not a secret: a namespace id is useless without an API token. Recreate
  // with: npx wrangler kv namespace create STORE
  "kv_namespaces": [
    {
      "binding": "STORE",
      "id": "106de8cc5db14be08543ad4c874dff6b"
    }
  ],

  "observability": {
    "enabled": true
  }
}
