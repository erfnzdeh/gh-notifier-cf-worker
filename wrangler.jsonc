{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gh-notifier",
  "main": "src/index.js",
  "compatibility_date": "2026-07-25",

  // 09:00 UTC daily. Cron Triggers are free (5 per account).
  "triggers": {
    "crons": ["0 9 * * *"]
  },

  "kv_namespaces": [
    {
      "binding": "FOLLOWERS",
      "id": "268a9a8344ab473db9d88aa5df9c8ccc"
    }
  ],

  "vars": {
    "GITHUB_USER": "erfnzdeh"
  },

  "observability": {
    "enabled": true
  }
}
